<rice:RiceWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls;assembly=KD.Avalonia.Rice"
                 xmlns:local="clr-namespace:KD.Avalonia.Rice.Demo"
                 xmlns:icons="clr-namespace:Material.Icons;assembly=Material.Icons"
                 x:Class="KD.Avalonia.Rice.Demo.MainWindow"
                 Width="980" Height="600" MinWidth="640" MinHeight="360"
                 WindowStartupLocation="CenterScreen"
                 ShowThemeSettingsButton="True" ShowAboutButton="True">
  <DockPanel>
    <rice:RiceSideMenu Name="SideMenu" DockPanel.Dock="Left" SelectedIndex="0">
      <rice:RiceSideMenu.Header>
        <TextBlock FontWeight="SemiBold" Text="Rice Demo" TextTrimming="CharacterEllipsis" />
      </rice:RiceSideMenu.Header>
      <rice:RiceSideMenuItem Icon="{x:Static icons:MaterialIconKind.HomeOutline}" Content="Home" />
      <rice:RiceSideMenuItem Icon="{x:Static icons:MaterialIconKind.Bookshelf}" Content="Library" />
      <rice:RiceSideMenuItem Icon="{x:Static icons:MaterialIconKind.DownloadOutline}" Content="Downloads" />
      <rice:RiceSideMenuItem Content="Linux">
        <rice:RiceSideMenuItem.Icon>
          <Image Source="/Assets/icon.png" />
        </rice:RiceSideMenuItem.Icon>
      </rice:RiceSideMenuItem>
      <rice:RiceSideMenuItem Icon="🍚" Content="Emoji icon" />
      <rice:RiceSideMenu.Footer>
        <StackPanel>
          <rice:RiceSideMenuItem Icon="{x:Static icons:MaterialIconKind.Cog}" Content="Settings"
                                 Click="OnSettingsClicked" />
          <rice:RiceSideMenuItem Icon="{x:Static icons:MaterialIconKind.InformationOutline}" Content="About"
                                 Click="OnAboutClicked" />
        </StackPanel>
      </rice:RiceSideMenu.Footer>
    </rice:RiceSideMenu>

    <Panel>
      <local:SettingsPage Name="SettingsPage" IsVisible="False" />
      <ScrollViewer Name="HomePage">
        <StackPanel Margin="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Name="PageTitle" FontSize="24" FontWeight="SemiBold" Text="Hello, Rice!" />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource RiceForegroundMutedBrush}"
                     Text="Use the lightbulb button to switch light and dark for this session. Pick a theme with the gear button in the title bar or on the Settings page – that choice is saved." />

          <Border Background="{DynamicResource RiceSurfaceBrush}" BorderBrush="{DynamicResource RiceBorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="Accent button" />
                <Button Content="Button" />
                <ToggleButton Content="Toggle" IsChecked="True" />
              </StackPanel>
              <TextBox PlaceholderText="Type something…" />
              <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox Content="Check me" IsChecked="True" />
                <RadioButton Content="One" GroupName="demo" IsChecked="True" />
                <RadioButton Content="Two" GroupName="demo" />
                <ToggleSwitch IsChecked="True" />
              </StackPanel>
              <Slider Value="40" />
              <ProgressBar Value="65" />
              <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Ubuntu" />
                <ComboBoxItem Content="Fedora" />
                <ComboBoxItem Content="Arch" />
              </ComboBox>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</rice:RiceWindow>
