<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls;assembly=KD.Avalonia.Rice"
             xmlns:icons="clr-namespace:Material.Icons;assembly=Material.Icons"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="KD.Avalonia.Rice.Demo.CardPage">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" HorizontalAlignment="Left">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="Card" />
      <TextBlock TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                 Foreground="{DynamicResource RiceForegroundMutedBrush}"
                 Text="RiceCard: optional header (title, subtitle, icon, actions), content and footer, with a shadow set by Elevation." />

      <WrapPanel ItemSpacing="16" LineSpacing="16">
        <rice:RiceCard Width="320" Header="Downloads" Subtitle="3 files, 1.2 GB"
                       Icon="{x:Static icons:MaterialIconKind.DownloadOutline}">
          <rice:RiceCard.HeaderActions>
            <Button Padding="6">
              <mi:MaterialIcon Kind="DotsVertical" />
            </Button>
          </rice:RiceCard.HeaderActions>
          <TextBlock TextWrapping="Wrap" Text="The ISO image is ready. Verify the checksum before installing." />
          <rice:RiceCard.Footer>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Cancel" />
              <Button Classes="accent" Content="Save" />
            </StackPanel>
          </rice:RiceCard.Footer>
        </rice:RiceCard>
        <rice:RiceCard Width="200" Header="Title only">
          <TextBlock TextWrapping="Wrap" Text="Only a header and content." />
        </rice:RiceCard>
        <rice:RiceCard Width="200" Icon="🍚" Header="Emoji icon" Subtitle="Any icon kind works" />
      </WrapPanel>

      <TextBlock FontWeight="SemiBold" Text="Elevation" />
      <WrapPanel ItemSpacing="16" LineSpacing="16">
        <rice:RiceCard Width="140" Elevation="0"><TextBlock Text="Elevation 0" /></rice:RiceCard>
        <rice:RiceCard Width="140" Elevation="1"><TextBlock Text="Elevation 1" /></rice:RiceCard>
        <rice:RiceCard Width="140" Elevation="2"><TextBlock Text="Elevation 2" /></rice:RiceCard>
        <rice:RiceCard Width="140" Elevation="3"><TextBlock Text="Elevation 3" /></rice:RiceCard>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
