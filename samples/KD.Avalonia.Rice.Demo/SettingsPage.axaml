<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons;assembly=Material.Icons"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls;assembly=KD.Avalonia.Rice"
             x:Class="KD.Avalonia.Rice.Demo.SettingsPage">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="Settings" />

      <TextBlock FontWeight="SemiBold" Text="Appearance" />
      <Border Background="{DynamicResource RiceSurfaceBrush}" BorderBrush="{DynamicResource RiceBorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="16">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <mi:MaterialIcon Kind="{x:Static icons:MaterialIconKind.PaletteOutline}" Width="24" Height="24" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Theme" />
            <TextBlock Name="CurrentThemeText" Foreground="{DynamicResource RiceForegroundMutedBrush}" />
          </StackPanel>
          <Button Grid.Column="2" Name="ChangeThemeButton" Content="Change…" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border Background="{DynamicResource RiceSurfaceBrush}" BorderBrush="{DynamicResource RiceBorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="16">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
          <mi:MaterialIcon Kind="{x:Static icons:MaterialIconKind.BlurLinear}" Width="24" Height="24" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Window background" />
            <TextBlock Foreground="{DynamicResource RiceForegroundMutedBrush}" TextWrapping="Wrap"
                       Text="Gradient: soft accent colors behind the content. Glass: the desktop shows through blurred, where the platform supports it." />
          </StackPanel>
          <rice:RiceSegmentedControl Grid.Column="2" Name="MaterialSwitch" VerticalAlignment="Center">
            <rice:RiceSegmentedItem Content="Solid" />
            <rice:RiceSegmentedItem Content="Gradient" />
            <rice:RiceSegmentedItem Content="Glass" />
          </rice:RiceSegmentedControl>
          <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="Animate the gradient" />
          <ToggleSwitch Grid.Row="1" Grid.Column="2" Name="AnimateSwitch" OnContent="" OffContent=""
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <TextBlock FontWeight="SemiBold" Text="General" />
      <Border Background="{DynamicResource RiceSurfaceBrush}" BorderBrush="{DynamicResource RiceBorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" Text="Start with the system" />
            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" Text="Check for updates" />
            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="True" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
