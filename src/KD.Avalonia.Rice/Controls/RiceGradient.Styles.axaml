<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls"
        xmlns:sched="clr-namespace:KD.Avalonia.Rice.Controls.Scheduling"
        xmlns:uml="clr-namespace:KD.Avalonia.Rice.Controls.Uml"
        xmlns:md="clr-namespace:KD.Avalonia.Rice.Controls.Markdowns">
  <!-- Gradient windows (RiceWindow:gradient): the large surfaces of the Rice controls turn translucent,
       so the color blobs show through the whole window. Inputs, buttons and popups stay solid
       to keep them readable. These are styles, not control themes, so they win over the setters of the control themes. -->

  <Style Selector="rice|RiceWindow:gradient rice|RiceSideMenu">
    <Setter Property="Background" Value="{DynamicResource RiceGradientChromeBrush}" />
  </Style>

  <Style Selector="rice|RiceWindow:gradient rice|RiceCard,
                   rice|RiceWindow:gradient rice|RiceTabView,
                   rice|RiceWindow:gradient rice|RiceTabViewItem:selected,
                   rice|RiceWindow:gradient rice|RicePropertyGrid,
                   rice|RiceWindow:gradient rice|RiceRibbon,
                   rice|RiceWindow:gradient sched|RiceScheduler,
                   rice|RiceWindow:gradient rice|RiceDockGroupView,
                   rice|RiceWindow:gradient rice|RiceDockTab:document:selected,
                   rice|RiceWindow:gradient rice|RiceDockLayout Button.rice-dock-strip">
    <Setter Property="Background" Value="{DynamicResource RiceGradientSurfaceBrush}" />
  </Style>

  <!-- Diagrams are drawn on the window color; let the gradient show instead. -->
  <Style Selector="rice|RiceWindow:gradient uml|UmlDiagramView, rice|RiceWindow:gradient md|MermaidView">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="rice|RiceWindow:gradient uml|UmlDiagramCanvas">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
