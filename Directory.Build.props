<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Version numbers come from version.json via Nerdbank.GitVersioning: <yy>.<month>.<git height>. -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="all" Condition="!Exists('packages.config')" />
  </ItemGroup>

  <!-- Reminds to bump version.json to the current year.month (do not use "nbgv set-version", it drops publicReleaseRefSpec). -->
  <Target Name="CheckCalendarVersion" BeforeTargets="Build" Condition="'$(MSBuildProjectName)' == 'KD.Avalonia.Rice'">
    <PropertyGroup>
      <_ExpectedCalendarVersion>$([System.DateTime]::Now.ToString("yy")).$([System.DateTime]::Now.Month)</_ExpectedCalendarVersion>
      <_VersionJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.json'))</_VersionJson>
      <_CurrentCalendarVersion>$([System.Text.RegularExpressions.Regex]::Match($(_VersionJson), '"version":\s*"([^"]+)"').Groups[1].Value)</_CurrentCalendarVersion>
    </PropertyGroup>
    <Warning Condition="'$(_CurrentCalendarVersion)' != '$(_ExpectedCalendarVersion)'"
             Text="version.json is $(_CurrentCalendarVersion), the current month would be $(_ExpectedCalendarVersion)." />
  </Target>
</Project>
