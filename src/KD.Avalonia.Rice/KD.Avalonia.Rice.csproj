<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>KD.Avalonia.Rice</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>Frameless Avalonia window with a custom title bar and Linux distro inspired themes, plus themed controls: side menu, card, group box, chat, progress ring, progress bar, spinner, loading overlay, UML diagrams (all 14 kinds, read from and written to PlantUML), a Markdown view (CommonMark + GFM) with syntax colored code and Mermaid diagrams, and 22 chart controls (column, bar, line, area, pie, donut, radar, scatter, bubble, heatmap, pyramid, funnel, waterfall, gantt, histogram, bullet, gauge, diverging bar).</Description>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>KD.Avalonia.Rice</PackageId>
    <Authors>k0zi</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>avalonia;theme;titlebar;frameless;linux;ubuntu;fedora;nord;dracula;sidemenu;navigation;card;groupbox;chat;progress;progressring;spinner;loading;overlay;uml;plantuml;diagram;markdown;commonmark;gfm;mermaid;chart;charts;graph;pie;gantt;heatmap;gauge</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="..\..\licenses\*.txt" Pack="true" PackagePath="licenses/" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="Assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KD.Avalonia.Rice.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
  </ItemGroup>
</Project>
