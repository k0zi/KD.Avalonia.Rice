<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons;assembly=Material.Icons"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="KD.Avalonia.Rice.Demo.SettingsPage">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="Settings" />

      <TextBlock FontWeight="SemiBold" Text="Appearance" />
      <Border Background="{DynamicResource RiceSurfaceBrush}" BorderBrush="{DynamicResource RiceBorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="16">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <mi:MaterialIcon Kind="{x:Static icons:MaterialIconKind.PaletteOutline}" Width="24" Height="24" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Theme" />
            <TextBlock Name="CurrentThemeText" Foreground="{DynamicResource RiceForegroundMutedBrush}" />
          </StackPanel>
          <Button Grid.Column="2" Name="ChangeThemeButton" Content="Change…" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <TextBlock FontWeight="SemiBold" Text="General" />
      <Border Background="{DynamicResource RiceSurfaceBrush}" BorderBrush="{DynamicResource RiceBorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" Text="Start with the system" />
            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" Text="Check for updates" />
            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="True" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
