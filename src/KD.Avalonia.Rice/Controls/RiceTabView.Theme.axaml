<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                    xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls">
  <!-- The selected tab takes the color of the content below it, so the two read as one sheet. -->
  <ControlTheme x:Key="{x:Type rice:RiceTabView}" TargetType="rice:RiceTabView">
    <Setter Property="Foreground" Value="{DynamicResource RiceForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource RiceSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RiceBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <DockPanel>
            <Border Name="PART_TabStrip" DockPanel.Dock="Top" Background="{DynamicResource RiceTrackBrush}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1">
              <DockPanel Margin="4,4,4,0">
                <ContentPresenter Name="PART_TabStripFooter" DockPanel.Dock="Right" VerticalAlignment="Center"
                                  Margin="4,0,0,4"
                                  Content="{TemplateBinding TabStripFooter}"
                                  IsVisible="{TemplateBinding TabStripFooter, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button Name="PART_AddButton" DockPanel.Dock="Right" Width="28" Height="28" Padding="0"
                        Margin="2,0,0,4" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        IsVisible="{TemplateBinding ShowAddButton}">
                  <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                </Button>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </DockPanel>
            </Border>
            <ContentPresenter Name="PART_SelectedContentHost"
                              Background="{TemplateBinding Background}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type rice:RiceTabViewItem}" TargetType="rice:RiceTabViewItem">
    <Setter Property="Foreground" Value="{DynamicResource RiceForegroundMutedBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="12,6,6,6" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="MaxWidth" Value="240" />
    <Setter Property="CornerRadius" Value="6,6,0,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_LayoutRoot"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <rice:RiceIconPresenter Name="PART_IconPresenter" Width="16" Height="16" Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Icon}"
                                      IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" VerticalAlignment="Center"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}" />
              <Button Name="PART_CloseButton" Grid.Column="2" Width="22" Height="22" Padding="0" Margin="6,0,0,0"
                      VerticalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="4"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      Foreground="{DynamicResource RiceForegroundMutedBrush}"
                      IsVisible="False" Focusable="False">
                <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
              </Button>
            </Grid>
          </Border>
          <!-- Accent line along the top of the selected tab. -->
          <Border Name="PART_SelectedPipe" Height="2" VerticalAlignment="Top" Margin="6,0"
                  CornerRadius="1" Background="{DynamicResource RiceAccentBrush}" IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:closable /template/ Button#PART_CloseButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource RiceForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource RiceHoverBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource RiceForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource RiceSurfaceBrush}" />
      <Style Selector="^ /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>
    <Style Selector="^:dragging">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <!-- Dragged out of the strip: it will become a window (or move to another view) when dropped. -->
    <Style Selector="^:tearing">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_LayoutRoot">
      <Setter Property="BorderBrush" Value="{DynamicResource RiceAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
