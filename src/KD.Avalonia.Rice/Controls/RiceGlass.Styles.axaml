<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls"
        xmlns:sched="clr-namespace:KD.Avalonia.Rice.Controls.Scheduling"
        xmlns:uml="clr-namespace:KD.Avalonia.Rice.Controls.Uml"
        xmlns:md="clr-namespace:KD.Avalonia.Rice.Controls.Markdowns">
  <!-- Glass and gradient windows (RiceWindow:translucent): the large surfaces of the Rice controls turn translucent,
       so the blurred desktop or the color blobs show through the whole window. Inputs, buttons and popups stay solid
       to keep them readable. These are styles, not control themes, so they win over the setters of the control themes. -->

  <Style Selector="rice|RiceWindow:translucent rice|RiceSideMenu">
    <Setter Property="Background" Value="{DynamicResource RiceGlassChromeBrush}" />
  </Style>

  <Style Selector="rice|RiceWindow:translucent rice|RiceCard,
                   rice|RiceWindow:translucent rice|RiceTabView,
                   rice|RiceWindow:translucent rice|RiceTabViewItem:selected,
                   rice|RiceWindow:translucent rice|RicePropertyGrid,
                   rice|RiceWindow:translucent rice|RiceRibbon,
                   rice|RiceWindow:translucent sched|RiceScheduler,
                   rice|RiceWindow:translucent rice|RiceDockGroupView,
                   rice|RiceWindow:translucent rice|RiceDockTab:document:selected,
                   rice|RiceWindow:translucent rice|RiceDockLayout Button.rice-dock-strip">
    <Setter Property="Background" Value="{DynamicResource RiceGlassSurfaceBrush}" />
  </Style>

  <!-- Diagrams are drawn on the window color; let the glass / gradient show instead. -->
  <Style Selector="rice|RiceWindow:translucent uml|UmlDiagramView, rice|RiceWindow:translucent md|MermaidView">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="rice|RiceWindow:translucent uml|UmlDiagramCanvas">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
