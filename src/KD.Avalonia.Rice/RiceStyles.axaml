<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="KD.Avalonia.Rice.RiceStyles">
  <FluentTheme />
  <mi:MaterialIconStyles />

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceWindow.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceSideMenu.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceChat.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceGroupBox.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceCard.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceProgressRing.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceProgressBar.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceSpinner.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceLoadingOverlay.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/Uml/UmlDiagramView.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/Markdowns/MarkdownView.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/Markdowns/MermaidView.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/Charts/RiceCharts.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Notifications/RiceToastItem.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceInfoBar.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceEmptyState.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceBreadcrumb.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceSegmentedControl.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceSkeleton.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceCommandPalette.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RicePropertyGrid.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceTabView.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceRibbon.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceTimeline.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceKanbanBoard.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceCodeEditor.Theme.axaml" />
        <ResourceInclude Source="avares://KD.Avalonia.Rice/Controls/RiceDockLayout.Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Fluent's corner radius for buttons, text boxes, combo boxes, ... -->
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    </ResourceDictionary>
  </Styles.Resources>

  <StyleInclude Source="avares://KD.Avalonia.Rice/Controls/RiceTitleBar.Styles.axaml" />
</Styles>
