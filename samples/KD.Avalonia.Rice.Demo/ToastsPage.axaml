<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls;assembly=KD.Avalonia.Rice"
             x:Class="KD.Avalonia.Rice.Demo.ToastsPage">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="Toasts" />
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource RiceForegroundMutedBrush}"
                 Text="RiceToast: short notifications in a corner of the window that close themselves. The color shows the kind: the theme's accent for info, green for success, amber for warning, red for error. Hover the toasts to pause the countdown." />

      <rice:RiceGroupBox Header="Kinds">
        <WrapPanel Name="KindButtons" ItemSpacing="8" LineSpacing="8" />
      </rice:RiceGroupBox>

      <rice:RiceGroupBox Header="Options">
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Name="TitleOnlyButton" Content="Title only" />
          <Button Name="StickyButton" Content="Stays until closed" />
          <Button Name="ActionButton" Content="With an action" />
          <Button Name="ClickableButton" Content="Clickable" />
          <Button Name="CustomContentButton" Content="Custom content" />
          <Button Name="BackgroundThreadButton" Content="From a background thread" />
        </WrapPanel>
      </rice:RiceGroupBox>

      <rice:RiceGroupBox Header="Host">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="Position" />
            <ComboBox Name="PositionBox" MinWidth="160" />
            <Button Name="CloseAllButton" Content="Close all" />
          </StackPanel>
        </StackPanel>
      </rice:RiceGroupBox>

      <TextBlock Name="ResultText" Foreground="{DynamicResource RiceForegroundMutedBrush}" Text="Result: –" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
