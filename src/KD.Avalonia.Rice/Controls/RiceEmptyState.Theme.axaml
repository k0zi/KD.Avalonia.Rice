<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls">
  <ControlTheme x:Key="{x:Type rice:RiceEmptyState}" TargetType="rice:RiceEmptyState">
    <Setter Property="Foreground" Value="{DynamicResource RiceForegroundBrush}" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <StackPanel MaxWidth="420" Spacing="8"
                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <rice:RiceIconPresenter Name="PART_IconPresenter" Margin="0,0,0,8" HorizontalAlignment="Center"
                                    Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                                    FontSize="{TemplateBinding IconSize}"
                                    Foreground="{DynamicResource RiceForegroundMutedBrush}" Opacity="0.7"
                                    Content="{TemplateBinding Icon}"
                                    IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Name="PART_Title" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                       Text="{TemplateBinding Title}"
                       IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Name="PART_Description" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource RiceForegroundMutedBrush}"
                       Text="{TemplateBinding Description}"
                       IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ContentPresenter Name="PART_ContentPresenter" Margin="0,8,0,0" HorizontalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
