<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls">
  <!-- Foreground is not set: the spinner takes the text color of its parent (e.g. white in an accent button). -->
  <ControlTheme x:Key="{x:Type rice:RiceSpinner}" TargetType="rice:RiceSpinner">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The ring's indeterminate animation; NaN lets it fill the spinner instead of its 40 px default. -->
        <rice:RiceProgressRing Name="PART_Ring" Width="NaN" Height="NaN"
                               Background="Transparent"
                               Foreground="{TemplateBinding Foreground}"
                               Thickness="{TemplateBinding Thickness}"
                               IsIndeterminate="{TemplateBinding IsActive}" />
      </ControlTemplate>
    </Setter>

    <Style Selector="^:active">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
