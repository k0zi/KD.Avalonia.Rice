<rice:RiceWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls;assembly=KD.Avalonia.Rice"
                 xmlns:icons="clr-namespace:Material.Icons;assembly=Material.Icons"
                 x:Class="KD.Avalonia.Rice.Demo.MainWindow"
                 Width="980" Height="600" MinWidth="640" MinHeight="360"
                 WindowStartupLocation="CenterScreen"
                 ShowThemeSettingsButton="True" ShowAboutButton="True">
  <DockPanel>
    <!-- One item per control; the icons show the supported kinds: image, Material icon, emoji.
         "Containers" has sub items: it expands / collapses instead of being selected. -->
    <rice:RiceSideMenu Name="SideMenu" DockPanel.Dock="Left">
      <rice:RiceSideMenu.Header>
        <TextBlock FontWeight="SemiBold" Text="Rice Demo" TextTrimming="CharacterEllipsis" />
      </rice:RiceSideMenu.Header>
      <rice:RiceSideMenuItem Name="HomeItem" Header="Home" IsSelected="True">
        <rice:RiceSideMenuItem.Icon>
          <Image Source="/Assets/icon.png" />
        </rice:RiceSideMenuItem.Icon>
      </rice:RiceSideMenuItem>
      <rice:RiceSideMenuItem Icon="{x:Static icons:MaterialIconKind.ViewDashboardOutline}" Header="Containers"
                             IsExpanded="True">
        <rice:RiceSideMenuItem Name="CardItem" Icon="{x:Static icons:MaterialIconKind.CardOutline}" Header="Card" />
        <rice:RiceSideMenuItem Name="GroupBoxItem" Icon="{x:Static icons:MaterialIconKind.SelectGroup}" Header="Group box" />
      </rice:RiceSideMenuItem>
      <rice:RiceSideMenuItem Name="ChatItem" Icon="💬" Header="Chat" />
      <rice:RiceSideMenuItem Name="ProgressItem" Icon="{x:Static icons:MaterialIconKind.ProgressClock}" Header="Progress" />
      <rice:RiceSideMenuItem Name="UmlItem" Icon="{x:Static icons:MaterialIconKind.SitemapOutline}" Header="UML" />
      <rice:RiceSideMenuItem Name="MarkdownItem" Icon="{x:Static icons:MaterialIconKind.LanguageMarkdownOutline}" Header="Markdown" />
      <rice:RiceSideMenuItem Name="ChartsItem" Icon="{x:Static icons:MaterialIconKind.ChartBar}" Header="Charts" />
      <rice:RiceSideMenuItem Name="DialogsItem" Icon="{x:Static icons:MaterialIconKind.MessageAlertOutline}" Header="Dialogs" />
      <rice:RiceSideMenuItem Name="ToastsItem" Icon="{x:Static icons:MaterialIconKind.BellOutline}" Header="Toasts" />
      <rice:RiceSideMenu.Footer>
        <StackPanel>
          <rice:RiceSideMenuItem Icon="{x:Static icons:MaterialIconKind.Cog}" Header="Settings"
                                 Click="OnSettingsClicked" />
          <rice:RiceSideMenuItem Icon="{x:Static icons:MaterialIconKind.InformationOutline}" Header="About"
                                 Click="OnAboutClicked" />
        </StackPanel>
      </rice:RiceSideMenu.Footer>
    </rice:RiceSideMenu>

    <ContentControl Name="PageHost" />
  </DockPanel>
</rice:RiceWindow>
